diff --git a/src/styles/dravenviz.css b/src/styles/dravenviz.css
index a06b48d..c36de1f 100644
--- a/src/styles/dravenviz.css
+++ b/src/styles/dravenviz.css
@@ -73,3 +73,19 @@
 .dravenviz-root .dravenviz-table th[data-align='end'] {
   text-align: end;
 }
+
+/*
+ * `fit: "width"` (mountCharts): the chart scales to its container's width with the aspect ratio
+ * kept. The logical layout and the SVG viewBox are unchanged. The chart's inner box carries inline
+ * pixel sizes, hence !important; only DravenViz-owned attributes are matched.
+ */
+.dravenviz-root[data-dv-fit='width'] {
+  display: block;
+  width: 100%;
+}
+
+.dravenviz-root[data-dv-fit='width'] > div {
+  width: 100% !important;
+  height: auto !important;
+  aspect-ratio: var(--dv-aspect);
+}
diff --git a/tests/browser/mount.spec.ts b/tests/browser/mount.spec.ts
index d4e8e22..a0efd61 100644
--- a/tests/browser/mount.spec.ts
+++ b/tests/browser/mount.spec.ts
@@ -437,3 +437,38 @@ test('a category with no point draws two separate paths (cat-absent)', async ({
   await h(page).mount([spec], opts);
   expect(await page.locator('[data-dv-mark="series:A:segment"] path').count()).toBe(2);
 });
+
+test('fit "width" scales the chart to its container and keeps the aspect ratio', async ({
+  page,
+}) => {
+  await page.addStyleTag({ path: 'src/styles/dravenviz.css' });
+  // Mount into a 178 mm wide host: the first harness host is created by `start`, so size it after.
+  const infoPromise = h(page).mount(['line-weekly-flow'], { ...opts, fit: 'width' });
+  await page.addStyleTag({ content: '[data-test-host]{width:178mm !important}' });
+  const [info] = await infoPromise;
+  expect(info).toEqual(
+    expect.objectContaining({ chartId: 'weekly-flow', width: 680, height: 320 }),
+  );
+  const svg = page.locator('svg[data-dravenviz-chart="weekly-flow"]');
+  await expect(svg).toHaveAttribute('viewBox', '0 0 680 320');
+  const box = await svg.evaluate((el) => {
+    const r = el.getBoundingClientRect();
+    const host = el.closest('[data-test-host]')!.getBoundingClientRect();
+    return { w: r.width, h: r.height, host: host.width };
+  });
+  expect(box.w).toBeCloseTo(box.host, 1);
+  expect(box.w).toBeCloseTo((178 / 25.4) * 96, 0);
+  expect(box.h / box.w).toBeCloseTo(320 / 680, 3);
+  // Plot geometry scales proportionally: the backdrop rect (680 wide in viewBox units) spans the svg.
+  const marks = await page
+    .locator('[data-dv-mark="series:closed:segment"] path')
+    .first()
+    .evaluate((p) => p.getBoundingClientRect().width);
+  expect(marks).toBeGreaterThan(0);
+  expect(marks).toBeLessThan(box.w);
+});
+
+test('an invalid fit option is INVALID_OPTIONS', async ({ page }) => {
+  const err = await h(page).mountError(['line-weekly-flow'], { ...opts, fit: 'stretch' });
+  expect(err.code).toBe('INVALID_OPTIONS');
+});
